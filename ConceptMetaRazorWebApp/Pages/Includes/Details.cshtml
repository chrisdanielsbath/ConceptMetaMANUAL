@page "/Includes/{includeId:int}"
@model ConceptMeta.ConceptMetaDb.RazorWebApp.Pages.Includes.DetailsModel

@{
    ViewData["Title"] = "Include Details";
}

<p>
    <a asp-page="../ConceptModels/Details" asp-route-conceptModelId="@Model.Breadcrumb_ConceptModel_ConceptModelId">@Model.Breadcrumb_ConceptModel_ValueString</a> &gt;
    <a asp-page="../Concepts/Details" asp-route-conceptId="@Model.Breadcrumb_Concept_ConceptId">@Model.Breadcrumb_Concept_ValueString</a> &gt;
    <a asp-page="Index" asp-route-conceptId="@Model.ConceptId">Includes</a> &gt;
    @Model.Include.ValueString
</p>
<h1>Details</h1>
<h3>@Model.Include.ValueString</h3>
<hr />
<p>
    <a asp-page="./Edit" asp-route-includeId="@Model.Include.IncludeId">Edit</a>
</p>
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Include.IncludeId" />
            <h4>Core Properties</h4>
            <div class="form-group">
                <label asp-for="Include.IncludeId" class="control-label"></label>
                <input asp-for="Include.IncludeId" class="form-control" disabled="disabled" />
            </div>
            <div class="form-group">
                <label asp-for="Include.ConceptValueString" class="control-label"></label>
                <input asp-for="Include.ConceptValueString" class="form-control" disabled="disabled" />
            </div>
            <div class="form-group">
                <label asp-for="Include.ItemValue" class="control-label"></label>
                <input asp-for="Include.ItemValue" class="form-control" disabled="disabled" />
            </div>
            <div class="form-group">
                <label asp-for="Include.SeqNo" class="control-label"></label>
                <input asp-for="Include.SeqNo" class="form-control" disabled="disabled" />
            </div>
        </form>
    </div>
