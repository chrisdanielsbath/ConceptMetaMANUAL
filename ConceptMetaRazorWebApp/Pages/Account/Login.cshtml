@page
@model ConceptMeta.ConceptMetaDb.RazorWebApp.Pages.Account.LoginModel

@{
    ViewData["Title"] = "Login";
}

<h1>Login</h1>

<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
@if (Model.LoginCredentials?.PasswordIsWrong == true)
{
            <div class="form-group">
                <span class="text-danger">Incorrect password, please try again</span>
            </div>
}
            <div class="form-group">
                <label asp-for="LoginCredentials.UserName" class="control-label"></label>
                <input asp-for="LoginCredentials.UserName" class="form-control" />
                <span asp-validation-for="LoginCredentials.UserName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="LoginCredentials.Password" class="control-label"></label>
                <input asp-for="LoginCredentials.Password" type="password" class="form-control" />
                <span asp-validation-for="LoginCredentials.Password" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Login" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>
@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}