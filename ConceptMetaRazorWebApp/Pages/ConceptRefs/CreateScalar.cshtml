        }

        $(document).ready(function () {
            setupSearch("hdnReferencedConceptVal", "hdnReferencedConceptText", "txtReferencedConceptSearch", "selReferencedConcept", "Concept", getReferencedConceptQueryString);
        });
    </script>
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
