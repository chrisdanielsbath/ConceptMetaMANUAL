@page
@model ConceptMeta.ConceptMetaDb.RazorWebApp.Pages.ConceptRefs.IndexModel

@{
    ViewData["Title"] = "ConceptRefs";
}

<p>
    <a asp-page="../ConceptModels/Details" asp-route-conceptModelId="@Model.Breadcrumb_ConceptModel_ConceptModelId">@Model.Breadcrumb_ConceptModel_ValueString</a> &gt;
    <a asp-page="../Concepts/Details" asp-route-conceptId="@Model.Breadcrumb_Concept_ConceptId">@Model.Breadcrumb_Concept_ValueString</a> &gt;
    ConceptRefs
</p>
<h1>ConceptRefs</h1>
<p>
    <a asp-page="Create" asp-route-conceptId="@Model.ConceptId">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.ConceptRefs[0].PropertyName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ConceptRefs[0].PropertyDescription)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ConceptRefs[0].ConceptRefType)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ConceptRefs[0].IsPropagating)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ConceptRefs[0].IsUpdatable)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ConceptRefs[0].IsNullable)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ConceptRefs[0].PropertySeq)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.ConceptRefs)
{
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.PropertyName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.PropertyDescription)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.ConceptRefType)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.IsPropagating)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.IsUpdatable)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.IsNullable)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.PropertySeq)
            </td>
            <td>
                <a asp-page="./Details" asp-route-conceptRefId="@item.ConceptRefId">Details</a> |
                <a asp-page="./Edit" asp-route-conceptRefId="@item.ConceptRefId">Edit</a> |
                <a asp-page="./Delete" asp-route-conceptRefId="@item.ConceptRefId">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
