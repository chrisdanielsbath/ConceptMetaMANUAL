@page "/Concepts/{conceptId:int}"
@model ConceptMeta.ConceptMetaDb.RazorWebApp.Pages.Concepts.DetailsModel

@{
    ViewData["Title"] = "Concept Details";
}

<p>
    <a asp-page="../ConceptModels/Details" asp-route-conceptModelId="@Model.Breadcrumb_ConceptModel_ConceptModelId">@Model.Breadcrumb_ConceptModel_ValueString</a> &gt;
    <a asp-page="Index" asp-route-conceptModelId="@Model.ConceptModelId">Concepts</a> &gt;
    @Model.Concept.ValueString
</p>
<h1>Details</h1>
<h3>@Model.Concept.ValueString</h3>
<hr />
<p>
    <a asp-page="./Edit" asp-route-conceptId="@Model.Concept.ConceptId">Edit</a> |
    <a asp-page="../Includes/Index" asp-route-conceptId="@Model.Concept.ConceptId">Includes</a> |
    <a asp-page="../Qualifiers/Index" asp-route-conceptId="@Model.Concept.ConceptId">Qualifiers</a> |
    <a asp-page="../ConceptPropertyFamilies/Index" asp-route-conceptId="@Model.Concept.ConceptId">PropertyFamilies</a> |
    <a asp-page="../ConceptUniqueKeys/Index" asp-route-conceptId="@Model.Concept.ConceptId">UniqueKeys</a> |
    <a asp-page="../ConceptSubTypes/Index" asp-route-conceptId="@Model.Concept.ConceptId">SubTypes</a> |
    <a asp-page="../ConceptRefs/Index" asp-route-conceptId="@Model.Concept.ConceptId">Properties</a>
</p>
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Concept.ConceptId" />
            <h4>Common Properties</h4>
            <div class="form-group">
                <label asp-for="Concept.ConceptId" class="control-label"></label>
                <input asp-for="Concept.ConceptId" class="form-control" disabled="disabled" />
            </div>
            <div class="form-group">
                <label asp-for="Concept.ConceptModelValueString" class="control-label"></label>
                <input asp-for="Concept.ConceptModelValueString" class="form-control" disabled="disabled" />
            </div>
            <div class="form-group">
                <label asp-for="Concept.ConceptName" class="control-label"></label>
                <input asp-for="Concept.ConceptName" class="form-control" disabled="disabled" />
            </div>
            <div class="form-group">
                <label asp-for="Concept.ConceptDescription" class="control-label"></label>
                <input asp-for="Concept.ConceptDescription" class="form-control" disabled="disabled" />
            </div>
            <div class="form-group">
                <label asp-for="Concept.ConceptType" class="control-label"></label>
                <input asp-for="Concept.ConceptType" class="form-control" disabled="disabled" />
            </div>
            <div class="form-group">
                <label asp-for="Concept.IsUpdatable" class="control-label"></label>
                <input asp-for="Concept.IsUpdatable" class="form-control" disabled="disabled" />
            </div>
            <h4>Enumeration Properties</h4>
            <div class="form-group">
