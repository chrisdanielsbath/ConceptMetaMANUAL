                <label asp-for="Concept.MaxLength" class="control-label"></label>
                <input asp-for="Concept.MaxLength" class="form-control" disabled="disabled" />
            </div>
            <h4>Number Properties</h4>
            <div class="form-group">
                <label asp-for="Concept.MinValue" class="control-label"></label>
                <input asp-for="Concept.MinValue" class="form-control" disabled="disabled" />
            </div>
            <div class="form-group">
                <label asp-for="Concept.MaxValue" class="control-label"></label>
                <input asp-for="Concept.MaxValue" class="form-control" disabled="disabled" />
            </div>
            <div class="form-group">
                <label asp-for="Concept.TotalDigits" class="control-label"></label>
                <input asp-for="Concept.TotalDigits" class="form-control" disabled="disabled" />
            </div>
            <div class="form-group">
                <label asp-for="Concept.DecimalPlaces" class="control-label"></label>
                <input asp-for="Concept.DecimalPlaces" class="form-control" disabled="disabled" />
            </div>
            <h4>Date Properties</h4>
            <div class="form-group">
                <label asp-for="Concept.DatePrecision" class="control-label"></label>
                <input asp-for="Concept.DatePrecision" class="form-control" disabled="disabled" />
            </div>
            <h4>Object Properties</h4>
            <div class="form-group">
                <label asp-for="Concept.DbSchemaName" class="control-label"></label>
                <input asp-for="Concept.DbSchemaName" class="form-control" disabled="disabled" />
            </div>
            <div class="form-group">
                <label asp-for="Concept.DbTableName" class="control-label"></label>
                <input asp-for="Concept.DbTableName" class="form-control" disabled="disabled" />
            </div>
            <div class="form-group">
                <label asp-for="Concept.IsCollectionItem" class="control-label"></label>
                <input asp-for="Concept.IsCollectionItem" class="form-control" disabled="disabled" />
            </div>
            <div class="form-group">
                <label asp-for="Concept.ToStringExpression" class="control-label"></label>
                <input asp-for="Concept.ToStringExpression" class="form-control" disabled="disabled" />
            </div>
            <div class="form-group">
                <label asp-for="Concept.IsCreatable" class="control-label"></label>
                <input asp-for="Concept.IsCreatable" class="form-control" disabled="disabled" />
            </div>
            <div class="form-group">
                <label asp-for="Concept.IsDeletable" class="control-label"></label>
                <input asp-for="Concept.IsDeletable" class="form-control" disabled="disabled" />
            </div>
            <div class="form-group">
                <label asp-for="Concept.SurrogateKeyFieldName" class="control-label"></label>
                <input asp-for="Concept.SurrogateKeyFieldName" class="form-control" disabled="disabled" />
            </div>
            <div class="form-group">
                <label asp-for="Concept.PrimaryKeyName" class="control-label"></label>
                <input asp-for="Concept.PrimaryKeyName" class="form-control" disabled="disabled" />
            </div>
            <div class="form-group">
                <label asp-for="Concept.AlternateKeyName" class="control-label"></label>
                <input asp-for="Concept.AlternateKeyName" class="form-control" disabled="disabled" />
            </div>
            <h4>Unique Key Properties</h4>
            <div class="form-group">
                <label asp-for="Concept.ReferencedConceptValueString" class="control-label"></label>
                <input asp-for="Concept.ReferencedConceptValueString" class="form-control" disabled="disabled" />
            </div>
            <div class="form-group">
                <label asp-for="Concept.ReferencedUniqueKeyValueString" class="control-label"></label>
                <input asp-for="Concept.ReferencedUniqueKeyValueString" class="form-control" disabled="disabled" />
            </div>
            <h4>Sub Type Properties</h4>
            <div class="form-group">
                <label asp-for="Concept.SpecialisedConceptValueString" class="control-label"></label>
                <input asp-for="Concept.SpecialisedConceptValueString" class="form-control" disabled="disabled" />
            </div>
            <div class="form-group">
                <label asp-for="Concept.SpecialisedSubTypeValueString" class="control-label"></label>
                <input asp-for="Concept.SpecialisedSubTypeValueString" class="form-control" disabled="disabled" />
            </div>
        </form>
    </div>
