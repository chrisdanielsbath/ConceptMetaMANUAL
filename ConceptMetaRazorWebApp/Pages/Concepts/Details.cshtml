                <input asp-for="Concept.EnumerationValueString" class="form-control" disabled="disabled" />
            </div>
            <h4>Data Type Properties</h4>
            <div class="form-group">
                <label asp-for="Concept.DataTypeValueString" class="control-label"></label>
                <input asp-for="Concept.DataTypeValueString" class="form-control" disabled="disabled" />
            </div>
            <h4>Scalar Properties</h4>
            <div class="form-group">
                <label asp-for="Concept.BasedOnConceptValueString" class="control-label"></label>
                <input asp-for="Concept.BasedOnConceptValueString" class="form-control" disabled="disabled" />
            </div>
            <div class="form-group">
                <label asp-for="Concept.ExampleValueAsString" class="control-label"></label>
                <input asp-for="Concept.ExampleValueAsString" class="form-control" disabled="disabled" />
            </div>
