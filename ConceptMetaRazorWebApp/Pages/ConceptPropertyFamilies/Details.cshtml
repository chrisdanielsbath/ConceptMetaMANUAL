@page "/ConceptPropertyFamilies/{conceptPropertyFamilyId:int}"
@model ConceptMeta.ConceptMetaDb.RazorWebApp.Pages.ConceptPropertyFamilies.DetailsModel

@{
    ViewData["Title"] = "ConceptPropertyFamily Details";
}

<p>
