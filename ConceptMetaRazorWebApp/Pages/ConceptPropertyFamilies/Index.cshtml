@page
@model ConceptMeta.ConceptMetaDb.RazorWebApp.Pages.ConceptPropertyFamilies.IndexModel

@{
    ViewData["Title"] = "ConceptPropertyFamilies";
}

<p>
    <a asp-page="../ConceptModels/Details" asp-route-conceptModelId="@Model.Breadcrumb_ConceptModel_ConceptModelId">@Model.Breadcrumb_ConceptModel_ValueString</a> &gt;
    <a asp-page="../Concepts/Details" asp-route-conceptId="@Model.Breadcrumb_Concept_ConceptId">@Model.Breadcrumb_Concept_ValueString</a> &gt;
    ConceptPropertyFamilies
</p>
<h1>ConceptPropertyFamilies</h1>
<p>
    <a asp-page="Create" asp-route-conceptId="@Model.ConceptId">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.ConceptPropertyFamilies[0].PropertyFamilyName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ConceptPropertyFamilies[0].SeqNo)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.ConceptPropertyFamilies)
{
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.PropertyFamilyName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.SeqNo)
            </td>
            <td>
                <a asp-page="./Details" asp-route-conceptPropertyFamilyId="@item.ConceptPropertyFamilyId">Details</a> |
                <a asp-page="./Edit" asp-route-conceptPropertyFamilyId="@item.ConceptPropertyFamilyId">Edit</a> |
                <a asp-page="./Delete" asp-route-conceptPropertyFamilyId="@item.ConceptPropertyFamilyId">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
