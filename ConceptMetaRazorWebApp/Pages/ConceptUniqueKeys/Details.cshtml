@page "/ConceptUniqueKeys/{conceptUniqueKeyId:int}"
@model ConceptMeta.ConceptMetaDb.RazorWebApp.Pages.ConceptUniqueKeys.DetailsModel

@{
    ViewData["Title"] = "ConceptUniqueKey Details";
}

<p>
    <a asp-page="../ConceptModels/Details" asp-route-conceptModelId="@Model.Breadcrumb_ConceptModel_ConceptModelId">@Model.Breadcrumb_ConceptModel_ValueString</a> &gt;
    <a asp-page="../Concepts/Details" asp-route-conceptId="@Model.Breadcrumb_Concept_ConceptId">@Model.Breadcrumb_Concept_ValueString</a> &gt;
    <a asp-page="Index" asp-route-conceptId="@Model.ConceptId">ConceptUniqueKeys</a> &gt;
    @Model.ConceptUniqueKey.ValueString
</p>
<h1>Details</h1>
<h3>@Model.ConceptUniqueKey.ValueString</h3>
<hr />
<p>
    <a asp-page="./Edit" asp-route-conceptUniqueKeyId="@Model.ConceptUniqueKey.ConceptUniqueKeyId">Edit</a> |
    <a asp-page="../ConceptUniqueKeyPropertyFamilyRefs/Index" asp-route-conceptUniqueKeyId="@Model.ConceptUniqueKey.ConceptUniqueKeyId">PropertyFamilyRefs</a>
</p>
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="ConceptUniqueKey.ConceptUniqueKeyId" />
            <h4>Common Properties</h4>
            <div class="form-group">
                <label asp-for="ConceptUniqueKey.ConceptUniqueKeyId" class="control-label"></label>
                <input asp-for="ConceptUniqueKey.ConceptUniqueKeyId" class="form-control" disabled="disabled" />
            </div>
            <div class="form-group">
                <label asp-for="ConceptUniqueKey.ConceptValueString" class="control-label"></label>
                <input asp-for="ConceptUniqueKey.ConceptValueString" class="form-control" disabled="disabled" />
            </div>
            <div class="form-group">
                <label asp-for="ConceptUniqueKey.UniqueKeyName" class="control-label"></label>
                <input asp-for="ConceptUniqueKey.UniqueKeyName" class="form-control" disabled="disabled" />
            </div>
        </form>
    </div>
