@page
@model ConceptMeta.ConceptMetaDb.RazorWebApp.Pages.DataTypes.IndexModel

@{
    ViewData["Title"] = "DataTypes";
}

<p>
    <a asp-page="../ConceptModels/Details" asp-route-conceptModelId="@Model.Breadcrumb_ConceptModel_ConceptModelId">@Model.Breadcrumb_ConceptModel_ValueString</a> &gt;
    DataTypes
</p>
<h1>DataTypes</h1>
<p>
    <a asp-page="Create" asp-route-conceptModelId="@Model.ConceptModelId">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.DataTypes[0].ConceptModelValueString)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DataTypes[0].DataTypeName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DataTypes[0].ExampleValueAsString)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DataTypes[0].BasicDataType)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.DataTypes)
{
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.ConceptModelValueString)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.DataTypeName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.ExampleValueAsString)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.BasicDataType)
            </td>
            <td>
                <a asp-page="./Details" asp-route-dataTypeId="@item.DataTypeId">Details</a> |
                <a asp-page="./Edit" asp-route-dataTypeId="@item.DataTypeId">Edit</a> |
                <a asp-page="./Delete" asp-route-dataTypeId="@item.DataTypeId">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
