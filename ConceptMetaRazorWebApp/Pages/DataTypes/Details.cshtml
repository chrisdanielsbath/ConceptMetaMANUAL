@page "/DataTypes/{dataTypeId:int}"
@model ConceptMeta.ConceptMetaDb.RazorWebApp.Pages.DataTypes.DetailsModel

@{
    ViewData["Title"] = "DataType Details";
}

<p>
    <a asp-page="../ConceptModels/Details" asp-route-conceptModelId="@Model.Breadcrumb_ConceptModel_ConceptModelId">@Model.Breadcrumb_ConceptModel_ValueString</a> &gt;
    <a asp-page="Index" asp-route-conceptModelId="@Model.ConceptModelId">DataTypes</a> &gt;
    @Model.DataType.ValueString
</p>
<h1>Details</h1>
<h3>@Model.DataType.ValueString</h3>
<hr />
<p>
    <a asp-page="./Edit" asp-route-dataTypeId="@Model.DataType.DataTypeId">Edit</a>
</p>
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="DataType.DataTypeId" />
            <h4>Core Properties</h4>
            <div class="form-group">
                <label asp-for="DataType.DataTypeId" class="control-label"></label>
                <input asp-for="DataType.DataTypeId" class="form-control" disabled="disabled" />
            </div>
            <div class="form-group">
                <label asp-for="DataType.ConceptModelValueString" class="control-label"></label>
                <input asp-for="DataType.ConceptModelValueString" class="form-control" disabled="disabled" />
            </div>
            <div class="form-group">
                <label asp-for="DataType.DataTypeName" class="control-label"></label>
                <input asp-for="DataType.DataTypeName" class="form-control" disabled="disabled" />
            </div>
            <div class="form-group">
                <label asp-for="DataType.ExampleValueAsString" class="control-label"></label>
                <input asp-for="DataType.ExampleValueAsString" class="form-control" disabled="disabled" />
            </div>
            <div class="form-group">
                <label asp-for="DataType.BasicDataType" class="control-label"></label>
                <input asp-for="DataType.BasicDataType" class="form-control" disabled="disabled" />
            </div>
            <h4>Database Properties</h4>
            <div class="form-group">
