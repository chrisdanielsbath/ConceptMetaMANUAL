                <label asp-for="DataType.MinLength" class="control-label"></label>
                <input asp-for="DataType.MinLength" class="form-control" disabled="disabled" />
            </div>
            <div class="form-group">
                <label asp-for="DataType.MaxLength" class="control-label"></label>
                <input asp-for="DataType.MaxLength" class="form-control" disabled="disabled" />
            </div>
            <div class="form-group">
                <label asp-for="DataType.HasLength" class="control-label"></label>
                <input asp-for="DataType.HasLength" class="form-control" disabled="disabled" />
            </div>
            <h4>Number Properties</h4>
            <div class="form-group">
                <label asp-for="DataType.MinValue" class="control-label"></label>
                <input asp-for="DataType.MinValue" class="form-control" disabled="disabled" />
            </div>
            <div class="form-group">
                <label asp-for="DataType.MaxValue" class="control-label"></label>
                <input asp-for="DataType.MaxValue" class="form-control" disabled="disabled" />
            </div>
            <div class="form-group">
                <label asp-for="DataType.HasIdentity" class="control-label"></label>
                <input asp-for="DataType.HasIdentity" class="form-control" disabled="disabled" />
            </div>
            <h4>Decimal Properties</h4>
            <div class="form-group">
                <label asp-for="DataType.TotalDigits" class="control-label"></label>
                <input asp-for="DataType.TotalDigits" class="form-control" disabled="disabled" />
            </div>
            <div class="form-group">
                <label asp-for="DataType.DecimalPlaces" class="control-label"></label>
                <input asp-for="DataType.DecimalPlaces" class="form-control" disabled="disabled" />
            </div>
            <div class="form-group">
                <label asp-for="DataType.HasTotalDigits" class="control-label"></label>
                <input asp-for="DataType.HasTotalDigits" class="form-control" disabled="disabled" />
            </div>
            <div class="form-group">
                <label asp-for="DataType.HasDecimalPlaces" class="control-label"></label>
                <input asp-for="DataType.HasDecimalPlaces" class="form-control" disabled="disabled" />
            </div>
            <h4>Date Properties</h4>
            <div class="form-group">
                <label asp-for="DataType.DatePrecision" class="control-label"></label>
                <input asp-for="DataType.DatePrecision" class="form-control" disabled="disabled" />
            </div>
            <div class="form-group">
                <label asp-for="DataType.HasDatePrecision" class="control-label"></label>
                <input asp-for="DataType.HasDatePrecision" class="form-control" disabled="disabled" />
            </div>
        </form>
    </div>
