            </div>
            <div class="form-group">
                <label asp-for="DataType.OracleDataType" class="control-label"></label>
                <input asp-for="DataType.OracleDataType" class="form-control" disabled="disabled" />
            </div>
            <div class="form-group">
                <label asp-for="DataType.MySqlDataType" class="control-label"></label>
                <input asp-for="DataType.MySqlDataType" class="form-control" disabled="disabled" />
            </div>
            <div class="form-group">
                <label asp-for="DataType.MongoDbDataType" class="control-label"></label>
                <input asp-for="DataType.MongoDbDataType" class="form-control" disabled="disabled" />
            </div>
            <div class="form-group">
                <label asp-for="DataType.ErsDataType" class="control-label"></label>
                <input asp-for="DataType.ErsDataType" class="form-control" disabled="disabled" />
