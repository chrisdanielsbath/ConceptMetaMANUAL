@page "/Enumerations/{enumerationId:int}/Delete"
@model ConceptMeta.ConceptMetaDb.RazorWebApp.Pages.Enumerations.DeleteModel

@{
    ViewData["Title"] = "Delete Enumeration";
}

<p>
    <a asp-page="../ConceptModels/Details" asp-route-conceptModelId="@Model.Breadcrumb_ConceptModel_ConceptModelId">@Model.Breadcrumb_ConceptModel_ValueString</a> &gt;
    <a asp-page="Index" asp-route-conceptModelId="@Model.ConceptModelId">Enumerations</a> &gt;
    @Model.Enumeration.ValueString
</p>
<h1>Delete</h1>

<h2>Are you sure you want to delete this?</h2>
<div>
    <h3>@Model.Enumeration.ValueString</h3>
    <hr />
    <dl class="dl-horizontal">
        <h4>Core Properties</h4>
        <dt>
            @Html.DisplayNameFor(model => model.Enumeration.ConceptModelValueString)
        </dt>
        <dd>
           @Html.DisplayFor(model => model.Enumeration.ConceptModelValueString)
        </dd>
        <dt>
            @Html.DisplayNameFor(model => model.Enumeration.EnumerationName)
        </dt>
        <dd>
            @Html.DisplayFor(model => model.Enumeration.EnumerationName)
        </dd>
        <dt>
            @Html.DisplayNameFor(model => model.Enumeration.EnumerationDescription)
        </dt>
        <dd>
            @Html.DisplayFor(model => model.Enumeration.EnumerationDescription)
        </dd>
        <dt>
            @Html.DisplayNameFor(model => model.Enumeration.DataTypeValueString)
        </dt>
        <dd>
           @Html.DisplayFor(model => model.Enumeration.DataTypeValueString)
        </dd>
    </dl>

    <form method="post">
        <input type="hidden" asp-for="Enumeration.EnumerationId" />
        <div class="form-actions no-color">
            <input type="submit" value="Delete" class="btn btn-danger" /> |
            <a asp-page="./Index" asp-route-conceptModelId="@Model.ConceptModelId">Back to List</a>
        </div>
    </form>
</div>
